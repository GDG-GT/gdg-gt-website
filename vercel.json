{
  "buildCommand": "npm run build:vercel",
  "outputDirectory": ".build/public",
  "devCommand": "npm run dev",
  "framework": "vite",
  "trailingSlash": false,
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https: blob:; connect-src 'self' https://*.supabase.co wss://*.supabase.co; frame-src https://docs.google.com https://www.youtube-nocookie.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; worker-src 'self' blob:; upgrade-insecure-requests; report-uri /api/v1/csp-reports"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/assets/(.*-[A-Za-z0-9_-]{8}\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*-[A-Za-z0-9_-]{8}\\.css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/((?!.*-[A-Za-z0-9_-]{8}\\.(?:js|css)$).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/admin/rewards",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/site?__route=/"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "/api/v1?__gdg_api_route=:path*"
    },
    {
      "source": "/index.html",
      "destination": "/api/site?__route=/"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/robots"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/rss.xml",
      "destination": "/api/rss"
    },
    {
      "source": "/feed",
      "destination": "/api/rss"
    },
    {
      "source": "/:route((?!api|assets|icons|_next|sw.js|offline.html|manifest.json|logo.png|logo.webp|favicon.png|favicon.ico|sitemap.xml|rss.xml|robots.txt|humans.txt).*)",
      "destination": "/api/site?__route=/:route"
    }
  ],
  "functions": {
    "api/site.mjs": {
      "maxDuration": 30,
      "includeFiles": "{dist/index.html,.build/ssr/**,shared/**}"
    },
    "api/v1.mjs": {
      "maxDuration": 60,
      "includeFiles": "{shared/**,public/logo.png}"
    },
    "api/scanner.mjs": {
      "maxDuration": 300,
      "includeFiles": "{.build/scanner/runtime/**,shared/**}"
    },
    "api/worker.mjs": {
      "maxDuration": 300,
      "includeFiles": "{.build/media-runtime/**,shared/**}"
    }
  }
}
