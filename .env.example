# Browser: same-origin application API only. Never put provider secrets in VITE_*.
VITE_REAL_API=true
VITE_LOCAL_UI=false

# Trusted API and worker environment. Use separate ignored files for local work.
NODE_ENV=production
APP_ORIGIN=https://your-approved-chapter-domain.example
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=
RISK_HASH_SECRET=
# Server-generated scrypt hash, never a plaintext gate code.
ADMIN_GATE_SECRET_HASH=
# High-entropy encryption secret (at least 32 characters); generate 32 random bytes.
DATA_ENCRYPTION_KEY=
CRON_SECRET=
ALLOW_INSECURE_LOCAL_COOKIES=false

# External email remains disabled until sender/domain and approval are configured.
MAIL_MODE=resend
EMAIL_SEND_ENABLED=false
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
FROM_EMAIL=
REPLY_TO_EMAIL=
CHAPTER_CONTACT_EMAIL=

# Push is disabled until approved VAPID identity and actual-device testing.
PUSH_ENABLED=false
PUSH_SEND_ENABLED=false
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:your-approved-chapter-address@example.org

# Private server-only Storage S3 credentials. All buckets remain private.
S3_ENDPOINT=https://your-project.supabase.co/storage/v1/s3
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
UPLOADS_ENABLED=false

# Isolated scan worker only. Never expose clamd to the public internet.
CLAMD_HOST=scanner.internal
CLAMD_PORT=13310

# Scoped Realtime: production uses an imported ES256 key, never a service key.
SUPABASE_PUBLISHABLE_KEY=
REALTIME_JWT_KEY_ID=
REALTIME_JWT_PRIVATE_JWK=
# Development-only legacy signing secret is never accepted outside loopback.
ALLOW_LOCAL_REALTIME_HS256=false
REALTIME_LOCAL_JWT_SECRET=

# Vercel standalone Node builder: preserve raw webhook request streams.
NODEJS_HELPERS=0

# Member points: separate host-only sessions; GT sign-in stays unavailable until IAM is configured.
REWARDS_ORIGIN=https://leaderboards.gdggt.dev
GT_MEMBER_SSO_ENABLED=false
GT_MEMBER_SSO_PROVIDER=custom:gatech

# Server-only Apple Wallet issuer. QR needs a Pass Type ID signing certificate.
APPLE_WALLET_QR_ENABLED=false
# NFC additionally needs Apple's contactless approval, VAS key and a tested reader.
APPLE_WALLET_NFC_ENABLED=false
APPLE_WALLET_READER_VERIFIED=false
APPLE_WALLET_PASS_TYPE_ID=
APPLE_WALLET_TEAM_ID=
APPLE_WALLET_SIGNER_CERT=
APPLE_WALLET_SIGNER_KEY=
APPLE_WALLET_KEY_PASSPHRASE=
APPLE_WALLET_WWDR_CERT=
APPLE_WALLET_NFC_PUBLIC_KEY=
# Owned iPhone Wallet reader, gated until Apple approves both issuer and VAS reader.
# Separate P-256 private key must match APPLE_WALLET_NFC_PUBLIC_KEY. Never use the pass signing key.
APPLE_WALLET_VAS_READER_ENABLED=false
APPLE_WALLET_VAS_PRIVATE_KEY=
APPLE_WALLET_VAS_KEY_PASSPHRASE=

# Server-only Google issuer. Publishing approval is separate from demo API access.
GOOGLE_WALLET_ENABLED=false
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
GOOGLE_WALLET_SERVICE_ACCOUNT_KEY=
GOOGLE_WALLET_KEY_PASSPHRASE=
GOOGLE_WALLET_PUBLISHING_APPROVED=false
# Smart Tap requires certified reader setup and its authentication key/Collector ID.
# Neither ordinary NFC nor Apple VAS approval enables Google Wallet tapping.
GOOGLE_WALLET_SMART_TAP_ENABLED=false
GOOGLE_WALLET_SMART_TAP_READER_READY=false
GOOGLE_WALLET_REDEMPTION_ISSUER_IDS=
